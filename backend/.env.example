DATABASE_URL=sqlite:///./data/ai_sana.db
DEMO_MODE=false
SESSION_HOURS=168
# Set true with HTTPS in production. Local HTTP requires false.
COOKIE_SECURE=false
FRONTEND_URL=http://127.0.0.1:5173
# file: local .eml files for testing; smtp: actual email delivery.
MAIL_MODE=file
MAIL_OUTBOX_DIR=data/outbox
MAIL_FROM=AI Sana <noreply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Gmail or another SMTP provider: see docs/student-teams-and-chat.md.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
# stub works offline and is explicitly marked in every assist response.
AI_PROVIDER=stub
# Optional local LLM. Set AI_PROVIDER=ollama and the name of your installed model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# Optional OpenAI Responses API. Put the real key only in the ignored backend/.env file.
# Set AI_PROVIDER=openai to use it; do not commit or put the key in frontend/VITE_*.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_TIMEOUT_SECONDS=30
